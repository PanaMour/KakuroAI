.main-menu {
    position: relative;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    background-color: rgb(30, 30, 30);
}

.title {
    font-size: 48px;
    color: white;
    margin-bottom: 30px;
}

.menu-buttons {
    flex-direction: column;
    align-items: center;
    justify-content: center;
}

.menu-button {
    width: 200px;
    height: 50px;
    font-size: 24px;
    margin-bottom: 20px;
    background-color: rgb(0, 122, 204);
    color: white;
    border-radius: 10px;
}

.menu-button:hover {
    background-color: rgb(0, 95, 153);
}

.options-panel {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 300px;
    padding: 20px;
    background-color: rgb(51, 51, 51);
    border-radius: 15px;
    flex-direction: column;
    align-items: center;
}

.options-title {
    font-size: 36px;
    color: white;
    margin-bottom: 20px;
}

.option-slider {
    width: 100%;
    margin-bottom: 5px;
}

.option-label {
    font-size: 20px;
    color: white;
    margin-bottom: 15px;
}
